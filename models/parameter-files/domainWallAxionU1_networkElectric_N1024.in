#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
fixedBackground = true
omegaEoS = 0.333333333333333333
evolver = RK2

#Lattice
N = 1024
dt = 0.003125
lSide = 32

#Times
tOutputFreq = 1
tOutputInfreq = 1
tOutputRareFreq = 1
t0 = 70
tMax = 102

#Spectra options
PS_type = 1
PS_version = 1
flagChiralPS = true

#GW options
withGWs = false
GWprojectorType = 1

#Defect observables
measureDefectsStructure = true
measureDefectsEnergies = true

#IC: pre-existing domain-wall network plus controllable electric U1 seed.
ICtype_S = DefectsNetwork
ICtype_U1 = BunchDavisElectricU1
lcorr = 4
kCutOff = 30
initial_amplitudes = 0
initial_momenta = 0

#Diffusion smooths only the wall network; U1 electric IC is restored afterward.
doDiffusion = true
tmaxdiff = 10
diffusionevolver = RK2
dtdiff = 0.0003125
tOutputFreqDiff = 1

#ResolutionPreserving
doResolutionPreserving = true
sRP = -1
tRP0 = 70

#Axion U1 coupling
alphaLambda_AxionU1 = 13
tNonLinearAxionU1 = -1
initial_E_amplitude = 1

#Model Parameters
lambda = 1
vev = 1
